    "about.thisApp.header" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RelCheck"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RelCheck"
          }
        }
      }
    },
    "about.thisApp.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RelCheck (codename: notifyme) came up as a small hackathon project during Apple Foundation Program Advanced. A version 0.1 was completed in about 36 hours thanks to the effort of two people: Dembo and Anne. The latter decided to continue working on the project to improve what could be.\\nThis app is made for, and dedicated to, all my ADHD and neuro-spicy people. With much love!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RelCheck (nom de code : notifyme) est né en tant que petit projet de hackathon durant l’Apple Foundation Program Advanced. Une version 0.1 a été terminée en environ 36 heures, grâce aux efforts de deux personnes : Dembo et Anne. La dernière a décidé de continue à travailler sur le projet pour l’améliorer autant que possible.\\nCette app est faite pour, et dédiée à, toustes mes adelphes de TDAH et neuro-atypiques. Avec amour !"
          }
        }
      }
    },
