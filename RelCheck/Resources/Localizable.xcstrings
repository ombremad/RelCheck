{
  "sourceLanguage" : "en",
  "strings" : {
    "about.author.header" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anne Ferret"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anne Ferret"
          }
        }
      }
    },
    "about.author.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anne Ferret (aka @ombremad) is a iOS developer, born in France, living between her birthplace and the Netherlands.\\nA former tech journalist, she started a career change in 2025: she attended Apple Foundation Program Advanced and learned to code! RelCheck is one of her first apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anne Ferret (aka @ombremad) est une développeuse iOS, née en France, vivant entre son pays de naissance et les Pays-Bas.\\nAncienne journaliste tech, elle a initié un changement de carrière en 2025 : elle a fait l’Apple Foundation Program Advanced et appris à coder ! RelCheck est une de ses premières apps."
          }
        }
      }
    },
    "about.links.anneFerretWebsite" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anne Ferret website"
