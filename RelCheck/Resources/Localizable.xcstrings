    "onboardingCard.01.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not everyone manages to stay in touch with their loved ones naturally. Some people just aren’t wired this way. That's where RelCheck come in."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde n’arrive pas à garder contact avec ses proches. Certain·es n’y arrivent pas naturellement. C’est là que RelCheck vient à la rescousse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Niet iedereen slaagt erin om van nature contact te houden met dierbaren. Bij sommige mensen zit dat simpelweg niet zo in elkaar. Daar komt RelCheck om de hoek kijken."
          }
        }
      }
    },
    "onboardingCard.01.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here to help"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Là pour aider"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hier om te helpen"
          }
        }
      }
    },
    "onboardingCard.02.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First, add a person into the app, and define how often you want to be reminded to contact them again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’abord, ajoute une personne dans l’app, et choisis à quelle fréquence tu veux être rappelé·e de reprendre contact."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voeg eerst iemand toe aan de app en bepaal hoe vaak je eraan herinnerd wilt worden om weer contact op te nemen."
          }
        }
      }
    },
    "onboardingCard.02.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a new contact"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un nouveau contact"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voeg een nieuw contact toe"
          }
        }
      }
    },
    "onboardingCard.03.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You get a notification when it’s time to get back in touch with someone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reçois une notification quand il est temps de renouer le contact avec quelqu’un."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je krijgt een melding zodra het tijd is om weer contact op te nemen met iemand."
          }
        }
      }
    },
    "onboardingCard.03.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Meldingen"
          }
        }
      }
    },
    "onboardingCard.04.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talk to someone the way you want (call, text…), and simply check-in in the app. You can check-in when it’s time by tapping the notification, or early directly in the app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parle à quelqu’un de la manière de ton choix (appel, SMS…), et indique à l’app une prise de contact. Tu peux le faire à l’échéance en cliquant sur la notification, ou à tout moment dans l’app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Praat met iemand op de manier die jij wilt (bellen, appen…) en registreer dat contactmoment simpelweg in de app. Je kunt dit doen zodra het zover is door op de melding te tikken, of eerder al rechtstreeks in de app."
          }
        }
      }
    },
    "onboardingCard.04.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check-in"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prise de contact"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Contactmoment"
          }
        }
      }
    },
    "onboardingCard.05.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also toggle the “fast check-in\" in Settings. Every day, you’ll get a notification to select quickly, of all your contacts, the ones you’ve made contact with today."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux aussi activer la sélection rapide dans les Réglages. Chaque jour, tu recevras une notification pour sélectionner rapidement, parmi tous tes contacts, ceux à qui tu as parlé aujourd’hui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je kunt 'Snel contactmoment' ook inschakelen bij Instellingen. Elke dag krijg je een melding om snel aan te geven met welke contacten je vandaag contact hebt gehad."
          }
        }
      }
    },
    "onboardingCard.05.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast check-in"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélection rapide"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Snel contactmoment"
          }
        }
      }
    },
