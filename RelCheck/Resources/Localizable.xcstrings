    "editContact.changedDays.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Days between notifications have been changed for this contact. Do you want to apply this setting right now or wait until after your next planned check-in?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’intervalle de jours entre les notifications a été changé. Veux-tu appliquer ce changement dès maintenant ou après la prochaine prise de contact ?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Het aantal dagen tussen meldingen voor dit contact is aangepast. Wil je deze instelling nu meteen toepassen of wachten tot na je volgende geplande contactmoment?"
          }
        }
      }
    },
